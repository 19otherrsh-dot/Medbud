# Dependencies (reinstall with `npm install`)
node_modules/

# Build outputs (regenerate with `npm run build`)
dist/
build/
out/
.next/
*.tsbuildinfo

# Turborepo cache
.turbo/

# Prisma generated client (regenerate with `npm run db:generate -w @medbud/database`)
generated/prisma/

# Environment files — real values stay local; templates are committed
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Test coverage
coverage/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.pem
.vercel
